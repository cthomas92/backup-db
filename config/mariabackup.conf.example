# Full physical backup seluruh instance MariaDB.
GCS_URI='gs://REPLACE_BUCKET/database-backups'
BACKUP_NAME='production-mariadb-physical'
# Harus berada di local disk dan cukup untuk satu backup terkompresi.
BACKUP_DIR='/var/lib/mariadb-backup'

MARIABACKUP_DEFAULTS_FILE='/etc/mariadb-backup/mariabackup.cnf'
MARIABACKUP_PARALLEL=1
ZSTD_LEVEL=3
ZSTD_THREADS=1
