# Gunakan account khusus dengan privilege baca/metadata saja, tanpa hak DML/DDL.
# Credentials/connection settings ONLY. No [mariadb-dump] section or dump options.
# Owned by the backup user, chmod 600.
[client]
user=backup_user
password="REPLACE_PASSWORD"
host=mariadb.example.com
port=3306
protocol=TCP
connect-timeout=15
ssl-ca=/etc/db-backup/ca.pem
ssl=1
ssl-verify-server-cert=1
# For a local Unix socket remove TCP/TLS settings and use socket=/run/mysqld/mysqld.sock
