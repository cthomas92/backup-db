# ============================================================
# AUTO BACKUP DATABASE -> GOOGLE CLOUD STORAGE
# Copy file ini menjadi .env lalu chmod 600 .env
# ============================================================

# ---------- GCS / umum ----------
GCS_URI='gs://NAMA_BUCKET/database-backups'
BACKUP_DIR="$SCRIPT_DIR/backups"

# Pilih salah satu cara auth GCS:
# 1) Jika VM sudah memakai attached service account / gcloud sudah login, biarkan kosong.
# 2) Jika memakai JSON key, isi path absolute atau file di folder script.
GCP_SERVICE_ACCOUNT_FILE=''
# GCP_SERVICE_ACCOUNT_FILE="$SCRIPT_DIR/service-account.json"

BACKUP_TIMEOUT_SECONDS=21600
UPLOAD_TIMEOUT_SECONDS=7200

# backup-all.sh akan menjalankan yang bernilai true.
BACKUP_MONGODB=true
BACKUP_MARIADB=true
BACKUP_MARIADB_PHYSICAL=false
BACKUP_POSTGRESQL=true

# ============================================================
# MongoDB
# ============================================================
MONGO_HOST='127.0.0.1'
MONGO_PORT=27017
MONGO_USER='backup_user'
MONGO_PASSWORD='GANTI_PASSWORD'
MONGO_AUTH_DB='admin'

# Isi database. Kosong = backup semua database (kecuali local).
MONGO_DATABASE='app_database'

# Kosong = semua collection pada database di atas.
# Isi nama collection jika hanya ingin backup satu collection.
MONGO_COLLECTION=''

# Jika MongoDB replica set, isi nama replica set, contoh: rs0
# Jika standalone, biarkan kosong.
MONGO_REPLICA_SET=''

# TLS opsional
MONGO_TLS=false
MONGO_TLS_CA_FILE=''

# Nama folder backup di GCS. Kosong = dibuat otomatis dari DB/collection.
MONGO_BACKUP_NAME=''

# ============================================================
# MariaDB logical (mariadb-dump)
# ============================================================
MARIADB_HOST='127.0.0.1'
MARIADB_PORT=3306
MARIADB_USER='backup_user'
MARIADB_PASSWORD='GANTI_PASSWORD'

# Jika backup dari host MariaDB lokal, socket lebih sederhana.
# Isi '' bila ingin koneksi TCP memakai HOST/PORT di atas.
MARIADB_SOCKET='/run/mysqld/mysqld.sock'

# Satu DB:
MARIADB_DATABASES='app_database'
# Banyak DB juga boleh, dipisah koma:
# MARIADB_DATABASES='app_database,billing_database'

# Opsional untuk koneksi TCP TLS.
MARIADB_SSL_CA=''
MARIADB_BACKUP_NAME='mariadb-logical'

# ============================================================
# MariaDB physical (mariadb-backup / mariabackup)
# Physical backup SELALU backup seluruh instance MariaDB.
# ============================================================
# Bila kosong, otomatis memakai MARIADB_USER / MARIADB_PASSWORD di atas.
# Disarankan user khusus physical backup karena privilege-nya berbeda.
MARIADB_PHYSICAL_USER=''
MARIADB_PHYSICAL_PASSWORD=''
MARIADB_PHYSICAL_SOCKET='/run/mysqld/mysqld.sock'
MARIADB_PHYSICAL_BACKUP_NAME='mariadb-full'
MARIABACKUP_PARALLEL=1
ZSTD_LEVEL=3
ZSTD_THREADS=1

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST='/var/run/postgresql'
POSTGRES_PORT=5432
POSTGRES_USER='backup_user'
POSTGRES_PASSWORD='GANTI_PASSWORD'
POSTGRES_DATABASE='app_database'
POSTGRES_CONNECT_TIMEOUT=15
POSTGRES_SSLMODE='prefer'
POSTGRES_SSLROOTCERT=''

# Kosong = default postgresql-NAMA_DATABASE
POSTGRES_BACKUP_NAME=''
