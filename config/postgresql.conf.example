# Folder tujuan di GCS. Hasil akhir ditambah /postgresql/BACKUP_NAME/ otomatis.
GCS_URI='gs://REPLACE_BUCKET/database-backups'
BACKUP_NAME='production-postgresql-app'
# Folder sementara di mesin database, bukan folder GCS.
BACKUP_DIR='/var/lib/db-backup'

PGHOST='postgres.example.com' # atau /var/run/postgresql untuk Unix socket
PGPORT=5432
# Gunakan role khusus dengan CONNECT, USAGE, dan SELECT saja; bukan superuser.
PGUSER='backup_user'
PGDATABASE='app_database'
PGPASSFILE='/etc/db-backup/pgpass'
PGSSLMODE='verify-full'
PGSSLROOTCERT='/etc/db-backup/ca.pem'
